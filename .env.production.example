# Modelo do .env de produção (Hostinger). O .env real fica só no servidor,
# na pasta do subdomínio, fora do git. Veja DEPLOY.md.

APP_NAME="Ward Artifacts"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://artifacts.wardtecnology.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u633753951_ward_artifacts
DB_USERNAME=u633753951_ward_artifacts
DB_PASSWORD=

# __Host- impede que o subdomínio de conteúdo sobrescreva o cookie de sessão.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=__Host-ward-session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@wardtecnology.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@wardtecnology.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Origem separada que serve o HTML dos artifacts (mesma pasta do app).
WARD_CONTENT_URL=https://artifacts-content.wardtecnology.com
WARD_DISPLAY_TIMEZONE=America/Sao_Paulo

# Migrations automáticas a cada commit novo (ward:post-deploy no cron).
WARD_POST_DEPLOY=true

# Primeiro admin: criado pelo ward:post-deploy quando o banco está vazio.
# Depois do primeiro deploy, pode apagar a senha daqui.
WARD_ADMIN_NAME=
WARD_ADMIN_USERNAME=
WARD_ADMIN_EMAIL=
WARD_ADMIN_PASSWORD=
