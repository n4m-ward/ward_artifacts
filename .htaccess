# Na Hostinger o repositório inteiro fica na pasta do subdomínio: tudo é
# reescrito para public/, então .env, storage/ e vendor/ nunca são servidos.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
